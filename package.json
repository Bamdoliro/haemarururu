{
  "name": "maruruuu",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "configs/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=./apps/**",
    "lint": "turbo run lint",
    "lint:staged": "eslint --fix && prettier --write",
    "type-check": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:staged": "prettier --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm format:staged",
      "bash -c 'pnpm type-check'",
      "pnpm lint:staged"
    ],
    "**/*.{json,md}": [
      "pnpm format:staged"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "eslint": "^8.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.0.0",
    "turbo": "^2.3.3",
    "typescript": "5.5.4"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.1",
      "@types/react-dom": "18.3.0"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
